# Copy to .env and fill in. Never commit .env.

# UI -> API base URL. docker-compose overrides this to http://api:8000 inside containers.
API_URL=http://localhost:8000

# Backend secrets (required)
GOOGLE_API_KEY=
PINECONE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=multimodal
# LANGFUSE_TRACING_ENABLED=false  # turn tracing off (the unit tests do this)